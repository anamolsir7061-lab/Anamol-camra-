<?xml version="1.0" encoding="utf-8"?>
<lensmind-filter version="1.0">
    <meta>
        <id>obsidian_cinema</id>
        <name>Obsidian Cinema</name>
        <icon>🎬</icon>
        <category>CINEMATIC</category>
        <author>LensMind Studio</author>
        <description>Anamorphic teal shadows and warm skin highlights.</description>
    </meta>
    <adjustments>
        <brightness>-0.04</brightness>
        <contrast>1.24</contrast>
        <saturation>0.92</saturation>
        <hue>-4.0</hue>
        <temperature>0.12</temperature>
        <greenery>-0.05</greenery>
        <blur>0.0</blur>
        <grain>0.18</grain>
        <vignette>0.38</vignette>
        <skinSmooth>0.15</skinSmooth>
        <highlights>-0.18</highlights>
        <shadows>0.10</shadows>
        <glitch>0.0</glitch>
        <blendMode>OVERLAY</blendMode>
        <lutPreset>TEAL_ORANGE</lutPreset>
    </adjustments>
    <ar-overlay type="NONE" anchor="FULL_FACE" scale="1.0" offsetY="0.0" tint="#00E5FF" animation="NONE" />
</lensmind-filter>
